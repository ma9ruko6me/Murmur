<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "https://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.example.murmur.auth.RefreshTokenMapper">

    <resultMap id="refreshTokenResultMap" type="com.example.murmur.auth.RefreshToken">
        <id property="id" column="id" />
        <result property="userId" column="user_id" />
        <result property="tokenHash" column="token_hash" />
        <result property="expiresAt" column="expires_at" />
        <result property="revokedAt" column="revoked_at" />
        <result property="createdAt" column="created_at" />
    </resultMap>

    <select id="findByTokenHash" resultMap="refreshTokenResultMap">
        SELECT id, user_id, token_hash, expires_at, revoked_at, created_at
        FROM refresh_tokens
        WHERE token_hash = #{tokenHash}
    </select>

    <insert id="insert" useGeneratedKeys="true" keyProperty="id">
        INSERT INTO refresh_tokens (user_id, token_hash, expires_at)
        VALUES (#{userId}, #{tokenHash}, #{expiresAt})
    </insert>

    <update id="revokeById">
        UPDATE refresh_tokens
        SET revoked_at = now()
        WHERE id = #{id}
    </update>

</mapper>
